# Files excluded from the distributed plugin (WordPress.org).
# Runtime stays: src/, assets/, vendor/, languages/, rapls-passkey.php,
# uninstall.php, readme.txt.

/.git
/.github
/.gitignore
/.distignore
.claude/
.cc-writes/
CLAUDE.md
README.md
.DS_Store

/docs
/tests
/bin
/node_modules
*.zip

# Build metadata: the recorded dependency tree (V84-01). It describes the
# package, it is not part of it.
/vendor-manifest.json

# composer.json ships WITH vendor/. WordPress.org's scan asks for it when a
# vendor/ directory is present, and it is the manifest that says what is in
# there. The lock stays out: it describes a build, not the package.
/composer.lock
/scoper.inc.php
/build

.DS_Store
*.log

# Local-only paths that .gitignore also excludes (V70-02). Staging is driven by
# git ls-files now, so these cannot reach the package in any case — they are
# listed so the two files agree, and so a build from an export (no git, the
# fallback path) is safe too.
/.ci
/.idea
/.vscode
Thumbs.db
