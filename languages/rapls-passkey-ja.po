# Japanese translation for Rapls Passkey.
msgid ""
msgstr ""
"Project-Id-Version: rapls-passkey\n"
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "%1$s / %2$s (%3$d%%)"
msgstr "%1$s / %2$s(%3$d%%)"

msgid "%1$s logins / %2$s new registrations"
msgstr "ログイン %1$s 件 / 新規登録 %2$s 件"

msgid "%d passkeys"
msgstr "%d 個"

msgid "(no name)"
msgstr "(名前なし)"

msgid "0.0 to 1.0. Scores below this are rejected (default 0.5)."
msgstr "0.0〜1.0。これ未満のスコアは拒否します(既定 0.5)。"

msgid "A new passkey was registered on your account."
msgstr "お使いのアカウントに新しいパスキーが登録されました。"

msgid "A passkey lets you sign in with your fingerprint, face, or device unlock (PIN) with no password. It resists phishing and avoids the risks of password reuse and leaks."
msgstr "パスキーは、指紋・顔認証や端末のロック解除(PIN)でログインできる、パスワード不要のしくみです。フィッシングに強く、パスワードの使い回しや漏えいの心配がありません。"

msgid "A site administrator removed one passkey from your account."
msgstr "サイト管理者により、お使いのアカウントのパスキーが1つ削除されました。"

msgid "Adoption"
msgstr "導入状況"

msgid "Advanced (WebAuthn)"
msgstr "詳細設定(WebAuthn)"

msgid "After login"
msgstr "ログイン後の表示"

msgid "Another device / QR (hybrid)"
msgstr "別の端末 / QR(hybrid)"

msgid "Audit log"
msgstr "監査ログ"

msgid "Authenticating..."
msgstr "認証しています…"

msgid "Authentication was cancelled or timed out. Please try again."
msgstr "認証がキャンセルされたか、時間切れになりました。もう一度お試しください。"

msgid "Authenticator"
msgstr "認証器"

msgid "Authenticator type"
msgstr "認証器の種類"

msgid "Authenticator: %s"
msgstr "認証器: %s"

msgid "Browser: %s"
msgstr "ブラウザ: %s"

msgid "Cancelled."
msgstr "キャンセルされました。"

msgid "Compatibility with security plugins"
msgstr "セキュリティプラグインとの互換"

msgid "Create a passkey"
msgstr "パスキーを作成"

msgid "Credential ID"
msgstr "資格情報 ID"

msgid "Cross-platform only (security key / another device)"
msgstr "外付けのみ(セキュリティキー / 別端末)"

msgid "Database tables"
msgstr "データベーステーブル"

msgid "Date/time (UTC)"
msgstr "日時 (UTC)"

msgid "Date/time: %s"
msgstr "日時: %s"

msgid "Delete"
msgstr "削除"

msgid "Delete this passkey?"
msgstr "このパスキーを削除しますか?"

msgid "Details"
msgstr "詳細"

msgid "Detected security plugins"
msgstr "検出したセキュリティプラグイン"

msgid "Detected security plugins: %s. The plugin adapts automatically to work even when the REST API is restricted."
msgstr "セキュリティプラグインを検出しました: %s。REST API 制限環境でも動作するよう自動対応しています。"

msgid "Discouraged"
msgstr "不要(discouraged)"

msgid "Email the affected user about passkey registration and removal, and about passkey sign-ins from a new device. Helps detect account takeover early."
msgstr "パスキーの登録・削除、および新しい端末からのパスキーサインインを、対象ユーザー本人のメールアドレスに通知します。乗っ取りの早期発見に役立ちます。"

msgid "Enable"
msgstr "有効化"

msgid "Enable reCAPTCHA"
msgstr "reCAPTCHA を有効にする"

msgid "Event"
msgstr "イベント"

msgid "Export CSV"
msgstr "CSV エクスポート"

msgid "Failed to register the passkey."
msgstr "パスキーの登録に失敗しました。"

msgid "Failed to save the passkey."
msgstr "パスキーの保存に失敗しました。"

msgid "Give supported browsers hints about which sign-in methods to suggest first (order is respected). No hints are sent if none are selected."
msgstr "対応ブラウザに対し、優先して案内する認証方法のヒントを与えます(順序も尊重されます)。未選択ならヒントなし。"

msgid "HTTPS / secure context"
msgstr "HTTPS / セキュアコンテキスト"

msgid "Hello %s,"
msgstr "%s さん"

msgid "How strongly to require identity verification via biometrics or PIN. Required may reject authenticators that do not support it; leaving this at Preferred is usually recommended."
msgstr "生体認証や PIN による本人確認をどの程度求めるか。「必須」は対応していない認証器を弾く可能性があります。通常は「推奨」のままを推奨します。"

msgid "IP address: %s"
msgstr "IP アドレス: %s"

msgid "If this was not you, change your password immediately and remove any unknown passkeys from your profile screen."
msgstr "心当たりがない場合は、すぐにパスワードを変更し、プロフィール画面から不明なパスキーを削除してください。"

msgid "If this was not you, change your password immediately and remove any unknown passkeys."
msgstr "心当たりがない場合は、すぐにパスワードを変更し、不明なパスキーを削除してください。"

msgid "If this was not you, change your password immediately."
msgstr "心当たりがない場合は、すぐにパスワードを変更してください。"

msgid "Invalid request."
msgstr "不正なリクエストです。"

msgid "Last %s"
msgstr "最終 %s"

msgid "Last 30 days"
msgstr "直近30日"

msgid "Last used"
msgstr "最終使用"

msgid "Later"
msgstr "後で"

msgid "Learn more"
msgstr "詳しく"

msgid "Loaded"
msgstr "読み込み済み"

msgid "Logging"
msgstr "記録"

msgid "Maximum number of passkeys a user can register. 0 means unlimited. We recommend 2 or more so passkeys can be used across multiple devices."
msgstr "ユーザーが登録できるパスキーの最大数。0 は無制限です。複数端末での利用を考慮し、2 以上を推奨します。"

msgid "Name"
msgstr "名前"

msgid "Name for this passkey (optional):"
msgstr "このパスキーの名前(任意):"

msgid "Name: %s"
msgstr "名前: %s"

msgid "No"
msgstr "いいえ"

msgid "No events have been recorded."
msgstr "記録されたイベントはありません。"

msgid "No known login-security plugins are detected."
msgstr "既知のログイン系セキュリティプラグインは検出されていません。"

msgid "No known login-security plugins were detected."
msgstr "既知のログイン系セキュリティプラグインは検出されませんでした。"

msgid "No passkeys are registered."
msgstr "登録済みのパスキーはありません。"

msgid "No preference (allow all)"
msgstr "指定なし(すべて許可)"

msgid "None"
msgstr "なし"

msgid "Not created"
msgstr "未作成"

msgid "Not found"
msgstr "未検出"

msgid "Not registered"
msgstr "未登録"

msgid "One passkey was removed from your account."
msgstr "お使いのアカウントからパスキーが1つ削除されました。"

msgid "Or sign in with a password"
msgstr "またはパスワードでログイン"

msgid "Passkey"
msgstr "パスキー"

msgid "Passkey audit log"
msgstr "パスキーの監査ログ"

msgid "Passkey authentication failed."
msgstr "パスキーでの認証に失敗しました。"

msgid "Passkey enrolment prompt"
msgstr "パスキー登録のうながし"

msgid "Passkey on this device (client-device)"
msgstr "この端末のパスキー(client-device)"

msgid "Passkey registered."
msgstr "パスキーを登録しました。"

msgid "Passkeys can only be registered from your own profile screen."
msgstr "パスキーの登録は本人のプロフィール画面からのみ行えます。"

msgid "Passkeys require HTTPS (a secure context). Install an SSL certificate and serve the site over HTTPS (except on localhost)."
msgstr "パスキーには HTTPS(安全なコンテキスト)が必要です。SSL 証明書を導入し、サイトを HTTPS で配信してください(localhost を除く)。"

msgid "Per-user registration limit"
msgstr "1ユーザーあたりの登録上限"

msgid "Per-user status is shown in the Passkey column of the Users list."
msgstr "各ユーザーの登録状況は「ユーザー」一覧の「パスキー」列で確認できます。"

msgid "Platform only (Touch ID / Windows Hello, etc.)"
msgstr "内蔵のみ(Touch ID / Windows Hello など)"

msgid "Please enter your username or email address."
msgstr "ユーザー名またはメールアドレスを入力してください。"

msgid "Please sign in to manage your passkeys."
msgstr "パスキーを管理するにはログインしてください。"

msgid "Preferred"
msgstr "推奨(preferred)"

msgid "Present"
msgstr "存在します"

msgid "Protect password logins with Google reCAPTCHA v3. It does not apply to passkey logins (brute force does not work against them). Enter your site key and secret, then enable it."
msgstr "パスワードによるログインを Google reCAPTCHA v3 で保護します。パスキーでのログインには適用されません(総当たり攻撃が成立しないため)。サイトキーとシークレットを入力し、有効化してください。"

msgid "Rapls Passkey (Passkey)"
msgstr "Rapls Passkey(パスキー)"

msgid "Rapls Passkey Settings"
msgstr "Rapls Passkey 設定"

msgid "Rapls Passkey uses only the standard login hooks and fires wp_login on a successful sign-in, so it coexists with these. If the login screen shows a duplicate CAPTCHA, disable one of them (you can disable this plugin reCAPTCHA in the settings above)."
msgstr "Rapls Passkey は標準のログインフックのみを使用し、ログイン成功時に wp_login を発火するため、これらと共存できます。ログイン画面の CAPTCHA が重複する場合は、どちらか一方を無効にしてください(本プラグインの reCAPTCHA は上記設定で無効化できます)。"

msgid "Rapls Passkey: Adoption"
msgstr "Rapls Passkey: 導入状況"

msgid "Rapls Passkey: Database"
msgstr "Rapls Passkey: データベース"

msgid "Rapls Passkey: The WebAuthn library is not loaded. Run `composer install` to install dependencies. Passkey authentication is disabled."
msgstr "Rapls Passkey: WebAuthn ライブラリが読み込まれていません。`composer install` を実行して依存関係を導入してください。パスキー認証は無効化されています。"

msgid "Rapls Passkey: The emergency bypass (RAPLS_PASSKEY_BYPASS) is enabled. Passkey enforcement is disabled. After recovery, remove the constant from wp-config.php."
msgstr "Rapls Passkey: 緊急バイパス (RAPLS_PASSKEY_BYPASS) が有効です。パスキーの強制は無効化されています。復旧後は wp-config.php から定数を削除してください。"

msgid "Rapls Passkey: WebAuthn library"
msgstr "Rapls Passkey: WebAuthn ライブラリ"

msgid "Recent events"
msgstr "最近のイベント"

msgid "Record events such as registration, login, and removal"
msgstr "登録・ログイン・削除などのイベントを記録する"

msgid "Register a passkey"
msgstr "パスキーを登録"

msgid "Registered"
msgstr "登録日時"

msgid "Registered passkeys"
msgstr "登録済みパスキー"

msgid "Registering passkey..."
msgstr "パスキーを登録しています…"

msgid "Registration was cancelled or timed out. Please try again."
msgstr "登録がキャンセルされたか、時間切れになりました。もう一度お試しください。"

msgid "Required"
msgstr "必須(required)"

msgid "Right after a password login, suggest creating a passkey on the spot (only for users without a passkey)"
msgstr "パスワードでログインした直後に、パスキーの作成をその場でおすすめする(パスキー未登録のユーザーのみ)"

msgid "Score threshold"
msgstr "スコアしきい値"

msgid "Secret key"
msgstr "シークレットキー"

msgid "Security"
msgstr "セキュリティ"

msgid "Security key (security-key)"
msgstr "セキュリティキー(security-key)"

msgid "Security notification emails"
msgstr "セキュリティ通知メール"

msgid "Send"
msgstr "送信"

msgid "Send security notification emails"
msgstr "セキュリティ通知メールを送信する"

msgid "Set up a passkey"
msgstr "パスキーの設定"

msgid "Set up a passkey on this device to sign in quickly next time without a password, using your fingerprint, face, or PIN. It also resists phishing."
msgstr "この端末にパスキーを設定すると、次回からパスワードなしで、指紋・顔認証・PIN ですばやくログインできます。フィッシングにも強くなります。"

msgid "Settings"
msgstr "設定"

msgid "Sign in faster and more securely next time"
msgstr "次回から、もっと速く安全にログイン"

msgid "Sign in with a passkey"
msgstr "パスキーでログイン"

msgid "Site key"
msgstr "サイトキー"

msgid "The WebAuthn library is loaded."
msgstr "WebAuthn ライブラリが読み込まれています。"

msgid "The WebAuthn library was not found. Run `composer install` to install dependencies. Passkey authentication is disabled."
msgstr "WebAuthn ライブラリが見つかりません。`composer install` を実行して依存関係を導入してください。パスキー認証は無効になっています。"

msgid "The credential and audit-log tables exist."
msgstr "認証情報・監査ログのテーブルが存在します。"

msgid "The current RP ID is %1$s and the site host is %2$s. The RP ID determines the scope of passkeys (changeable via the rapls_passkey_rp_id filter)."
msgstr "現在の RP ID は「%1$s」、サイトのホストは「%2$s」です。RP ID はパスキーの有効範囲を決めます(rapls_passkey_rp_id フィルターで変更可)。"

msgid "The following plugins were detected:"
msgstr "次のプラグインを検出しました:"

msgid "The operation was cancelled or timed out. Please try again."
msgstr "操作がキャンセルされたか、時間切れになりました。もう一度お試しください。"

msgid "The plugin database tables were not found. Deactivate and reactivate the plugin to create them."
msgstr "プラグインのデータベーステーブルが見つかりません。プラグインを一度無効化してから再度有効化すると作成されます。"

msgid "The site is served over a secure context (HTTPS)."
msgstr "サイトは安全なコンテキスト(HTTPS)で配信されています。"

msgid "This authenticator already has a passkey registered."
msgstr "この認証器にはすでにパスキーが登録されています。"

msgid "This browser does not support passkeys."
msgstr "このブラウザはパスキーに対応していません。"

msgid "This passkey is already registered."
msgstr "このパスキーはすでに登録されています。"

msgid "Timeout (seconds)"
msgstr "タイムアウト(秒)"

msgid "Timeout for the passkey registration and authentication dialogs. 0 uses the browser default (typically around 60 seconds)."
msgstr "パスキーの登録・認証ダイアログのタイムアウト。0 はブラウザ既定(通常 60 秒程度)を使用します。"

msgid "Too many attempts. Please try again later."
msgstr "試行回数が多すぎます。しばらくしてからお試しください。"

msgid "Total registered passkeys"
msgstr "登録済みパスキー総数"

msgid "Total registered passkeys: %d"
msgstr "登録済みパスキーの総数: %d 個"

msgid "UI hints"
msgstr "UI ヒント"

msgid "Unknown"
msgstr "不明"

msgid "User ID"
msgstr "ユーザーID"

msgid "User verification"
msgstr "ユーザー検証"

msgid "Username"
msgstr "ユーザー名"

msgid "Username or email address"
msgstr "ユーザー名またはメールアドレス"

msgid "Users"
msgstr "ユーザー"

msgid "Users list"
msgstr "ユーザー一覧"

msgid "Users with a passkey"
msgstr "パスキーを持つユーザー"

msgid "Users with a passkey: %1$d / %2$d (%3$d%%)"
msgstr "パスキーを登録済みのユーザー: %1$d / %2$d 人(%3$d%%)"

msgid "Version"
msgstr "バージョン"

msgid "WebAuthn library"
msgstr "WebAuthn ライブラリ"

msgid "What is a passkey?"
msgstr "パスキーとは?"

msgid "Which authenticator type to allow at registration (applies at registration only). No preference is usually recommended."
msgstr "新規登録時に許可する認証器の種類(登録時のみ適用)。通常は「指定なし」を推奨します。"

msgid "Yes"
msgstr "はい"

msgid "You are already signed in."
msgstr "すでにログインしています。"

msgid "You can register at most %d passkeys. Remove an unused passkey before registering a new one."
msgstr "登録できるパスキーは最大 %d 個です。不要なパスキーを削除してから登録してください。"

msgid "You do not have permission to delete this passkey."
msgstr "このパスキーを削除する権限がありません。"

msgid "You do not have permission."
msgstr "権限がありません。"

msgid "Your account was signed into using a recovery code."
msgstr "リカバリーコードを使用してアカウントにサインインしました。"

msgid "Your account was signed into with a passkey from a device or browser not seen before."
msgstr "これまでに記録のない端末またはブラウザから、パスキーでアカウントにサインインしました。"

msgid "Your registered passkeys"
msgstr "登録済みのパスキー"

msgid "[%s] A new passkey was registered"
msgstr "[%s] 新しいパスキーが登録されました"

msgid "[%s] A passkey was removed"
msgstr "[%s] パスキーが削除されました"

msgid "[%s] New device sign-in"
msgstr "[%s] 新しい端末からサインインしました"

msgid "[%s] You signed in with a recovery code"
msgstr "[%s] リカバリーコードでサインインしました"

msgid "reCAPTCHA could not be verified. Reload the page and try again."
msgstr "reCAPTCHA の確認に失敗しました。ページを再読み込みしてお試しください。"

msgid "reCAPTCHA v3 (password login protection)"
msgstr "reCAPTCHA v3(パスワードログイン保護)"

msgid "reCAPTCHA verification failed."
msgstr "reCAPTCHA の検証に失敗しました。"

msgid "You cannot sign in to this account right now."
msgstr "現在このアカウントにはログインできません。"
