msgstr "パスキーを登録しています…"

#: src/Admin/ProfileUi.php:74 src/Frontend/Shortcodes.php:98
#: src/Login/UpgradePrompt.php:127
msgid "Passkey registered."
msgstr "パスキーを登録しました。"

