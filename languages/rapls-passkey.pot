#: src/Admin/SettingsPage.php:156
msgid "Per-user registration limit"
msgstr ""

#: src/Admin/SettingsPage.php:159
msgid "Maximum number of passkeys a user can register. 0 means unlimited. We recommend 2 or more so passkeys can be used across multiple devices."
msgstr ""

#: src/Admin/SettingsPage.php:164
msgid "Login rate limit"
msgstr ""

#: src/Admin/SettingsPage.php:167
msgid "Attempt limit"
msgstr ""

#: src/Admin/SettingsPage.php:170
msgid "How many failed passkey-login attempts from the same IP address are allowed within the window below before \"Too many attempts\" is shown. Successful logins are not counted. 0 disables the limit."
msgstr ""

#: src/Admin/SettingsPage.php:174
msgid "Lockout time (seconds)"
msgstr ""

#: src/Admin/SettingsPage.php:177
msgid "The length of the counting window, and how long the lockout lasts once the attempt limit is reached (default 300 seconds = 5 minutes)."
msgstr ""

#: src/Admin/SettingsPage.php:182
msgid "Session security"
msgstr ""

#: src/Admin/SettingsPage.php:185
msgid "Administrator \"remember me\""
msgstr ""

#: src/Admin/SettingsPage.php:189
msgid "Allow administrators to stay signed in (\"remember me\") after a passkey login"
msgstr ""

#: src/Admin/SettingsPage.php:191
msgid "Off by default for safety: administrators never get a persistent session, so a shared or stolen device cannot keep an admin logged in. Turn this on to honour the \"remember me\" checkbox for administrators too. Non-administrators are unaffected."
msgstr ""

#: src/Admin/SettingsPage.php:195
msgid "Two-factor on alternative logins"
msgstr ""

#: src/Admin/SettingsPage.php:199
msgid "Ask for the site's two-factor code on the logins that are weaker than a passkey"
msgstr ""

#: src/Admin/SettingsPage.php:202
msgid "Two-factor plugins (Wordfence Login Security, Two-Factor, ...) only enforce inside the wp-login.php password chain, which the email magic link and the recovery-code login do not go through — so without this they are a way around your 2FA. A passkey sign-in (including the QR cross-device flow) is itself the second factor and is never challenged. Only users who have actually set a second factor up see the challenge."
msgstr ""

#: src/Admin/SettingsPage.php:206
msgid "No supported two-factor plugin detected, so this setting currently has no effect."
msgstr ""

#: src/Admin/SettingsPage.php:209
msgid "Detected:"
msgstr ""

#: src/Admin/SettingsPage.php:223
msgid "Advanced (WebAuthn)"
msgstr ""

#: src/Admin/SettingsPage.php:226
msgid "Timeout (seconds)"
msgstr ""

#: src/Admin/SettingsPage.php:229
msgid "Timeout for the passkey registration and authentication dialogs. 0 uses the browser default (typically around 60 seconds)."
